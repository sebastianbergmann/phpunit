<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../../../../../../phpunit.xsd"
         bootstrap="bootstrap.php"
         cacheDirectory=".phpunit.cache.property-that-covers-nothing"
         recordTestImpactData="true">
    <testsuites>
        <testsuite name="default">
            <file>tests/PropertyThatCoversNothingTest.php</file>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>src</directory>
        </include>

        <exclude>
            <file>src/DriverThatReportsWhatWasCalledWhileItRan.php</file>
        </exclude>
    </source>

    <coverage driver="PHPUnit\TestFixture\TestImpactData\Properties\DriverThatReportsWhatWasCalledWhileItRan"/>
</phpunit>
