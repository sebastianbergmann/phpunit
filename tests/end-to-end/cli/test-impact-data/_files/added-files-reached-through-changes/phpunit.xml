<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../../../../../../phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         recordTestImpactData="true">
    <testsuites>
        <testsuite name="default">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>src</directory>
        </include>

        <exclude>
            <file>src/DriverWithFakeData.php</file>
        </exclude>
    </source>

    <testImpactAnalysis>
        <addedFilesAreReachedThroughChanges>
            <include>
                <directory>src</directory>
            </include>

            <exclude>
                <directory>src/Discovered</directory>
            </exclude>
        </addedFilesAreReachedThroughChanges>
    </testImpactAnalysis>

    <coverage driver="PHPUnit\TestFixture\TestImpactData\AddedFilesReachedThroughChanges\DriverWithFakeData"/>
</phpunit>
